# ==============================
# OTP CONFIG
# ==============================
# prod  = real random OTP, real SMS sent, strict checks (USE THIS IN PRODUCTION)
# dev   = real random OTP, SMS NOT sent, OTP logged + returned in API response
# test  = OTP is always OTP_STATIC_CODE for every number, SMS NOT sent
#         (use for QA / app-store review / automated tests)
OTP_MODE=dev
OTP_STATIC_CODE=123456

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30

# per-phone-number abuse limits
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_ABUSE_BLOCK_MINUTES=60

# per-IP abuse limits (protects against one IP cycling many phone numbers)
OTP_IP_SEND_MAX_PER_HOUR=20
OTP_IP_VERIFY_MAX_PER_15MIN=30

